# Copy this file to .streamlit/secrets.toml (gitignored) and fill in your values.
# Never commit secrets.toml. On Azure App Service, set the same names as Application settings instead.
AZURE_OPENAI_ENDPOINT = "https://<your-resource-name>.openai.azure.com/"
AZURE_OPENAI_API_KEY = "<your-key>"
AZURE_OPENAI_DEPLOYMENT = "grantscope-gpt4o"
AZURE_OPENAI_API_VERSION = "2024-10-21"
